<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentConnect</RootNamespace>
    <AssemblyName>AgentConnect.DeletionJob</AssemblyName>
    <Description>Scheduled background deletion for AgentConnect. Run it; do not run deletion inside the web apps.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgentConnect.Composition\AgentConnect.Composition.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>
</Project>
